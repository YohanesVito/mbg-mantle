{
  "name": "@mbg/tee-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Phala TDX worker for MBG — runs the scoring engine inside an enclave and submits attested scores to the RiskOracle on Mantle",
  "scripts": {
    "dev": "bun run src/index.ts",
    "integrate": "bun run src/integrate.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mbg/be": "workspace:*",
    "@phala/dstack-sdk": "^0.5.7",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
